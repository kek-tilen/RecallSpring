# Copy to services/api/.env (gitignored). Use the same password as infra/.env.
RS_ENVIRONMENT=development
RS_DATABASE_URL=postgresql+psycopg://recallspring:change-me-local-only@127.0.0.1:55432/recallspring
# Local HTTP on 127.0.0.1 only; keep true anywhere else.
RS_COOKIE_SECURE=false
# Development only: simulated AI, always labelled "Simulated" and never lengthens review intervals.
RS_AI_EVALUATION_PROVIDER=mock
RS_AI_QUESTION_PROVIDER=mock
# Backups (docs/08 -> Backups): default local-data/backups, the same disk as your files. Another disk or a synced
# folder protects against a broken disk, e.g.:
# RS_BACKUP_DIR=D:/RecallSpring-backups   (or choose it in Settings → Data & backups)
